# CareerGraph AI - Environment Configuration Example
# Copy this file to backend/.env and fill in your values.
# The backend reads .env from its own working directory.
# NEVER commit .env to Git.
# For a shared deployment, set DEBUG=False, ENVIRONMENT=production,
# a strong SECRET_KEY, and exact HTTPS CORS origins.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=CareerGraph AI
APP_VERSION=0.1.0
# Local development may use True. Use False for any shared deployment.
DEBUG=True
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local SQLite (no Docker needed). The path is relative to backend/.
DATABASE_URL=sqlite:///./careergraph_dev.db

# PostgreSQL example for a shared deployment:
# DATABASE_URL=postgresql+psycopg2://careergraph:careergraph_pass@localhost:5432/careergraph_db

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON array of exact allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Skill graph
# ---------------------------------------------------------------------------
# GRAPH_BACKEND=memory -> built-in in-memory graph (default)
# GRAPH_BACKEND=neo4j  -> Neo4j adapter; falls back to memory if unreachable
GRAPH_BACKEND=memory

# ---------------------------------------------------------------------------
# Neo4j (optional; used when GRAPH_BACKEND=neo4j)
# ---------------------------------------------------------------------------
# The adapter requires a reachable Neo4j 5 server. The ordinary local suite uses
# the in-memory backend; a disposable Neo4j service is exercised by the CI
# integration job. Never point a destructive integration test at production.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ---------------------------------------------------------------------------
# Grounded career advisor (optional LLM)
# ---------------------------------------------------------------------------
# Retrieval is always local lexical BM25 over the curated in-repo corpus.
# Leave OPENROUTER_API_KEY empty for deterministic local answers with no
# external AI request. If configured, only the question, target occupation,
# canonical skill names, gap summary, roadmap step names and retrieved curated
# excerpts are sent to OpenRouter. Resume files/text, email, names, account IDs
# and tokens are never included. The key stays backend-only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.2
RAG_TOP_K=6
RAG_MIN_SCORE=1.0
# There is no built-in per-user LLM spend quota; add rate limiting at the API
# gateway before enabling a paid provider in a public deployment.
